<Window x:Class="RecallLocal.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RecallLocal — Settings &amp; Privacy Shield"
        Width="660"
        Height="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="#090B0E"
            BorderBrush="#232A36"
            BorderThickness="1"
            CornerRadius="14"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="5" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="#12161E"
                    BorderBrush="#232A36"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    Padding="20,14"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Settings &amp; Privacy Shield" Foreground="#F1F5F9" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="OcrEngineInfoText" Text="100% Local Vault • Zero Cloud Telemetry" Foreground="#10B981" FontSize="11.5" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Content="✕"
                            Style="{StaticResource ObsidianButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="10,5"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Main Settings Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>

                    <!-- Storage Usage Meter Card -->
                    <Border Background="#12161E" BorderBrush="#232A36" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Local Vault Storage" Foreground="#F1F5F9" FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StorageSummaryText" Text="0 MB used • 0 snapshots" Foreground="#38BDF8" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border Height="8" CornerRadius="4" Background="#090B0E" BorderBrush="#232A36" BorderThickness="1" Margin="0,0,0,10">
                                <Border x:Name="StorageMeterFill" HorizontalAlignment="Left" Width="20" CornerRadius="3" Background="#38BDF8"/>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="IndexedWordsText" Text="Words: 0" Foreground="#94A3B8" FontSize="11.5"/>
                                <TextBlock Grid.Column="1" x:Name="UniqueAppsText" Text="Apps: 0" Foreground="#94A3B8" FontSize="11.5" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="OcrPackText" Text="OCR: Ready" Foreground="#10B981" FontSize="11.5" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Capture Cadence & Retention Card -->
                    <Border Background="#12161E" BorderBrush="#232A36" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Capture &amp; Retention" Foreground="#F1F5F9" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <!-- Capture Interval Slider -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Capture Interval (perceptual-hash skips idle screens)" Foreground="#94A3B8" FontSize="12"/>
                                <TextBlock x:Name="IntervalValueText" Text="5s" Foreground="#38BDF8" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="IntervalSlider"
                                    Style="{StaticResource TimelineSliderStyle}"
                                    Minimum="3" Maximum="30" Value="5"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    ValueChanged="IntervalSlider_ValueChanged"
                                    Margin="0,0,0,12"/>

                            <!-- Retention Days Slider -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Automatic Retention Pruning" Foreground="#94A3B8" FontSize="12"/>
                                <TextBlock x:Name="RetentionValueText" Text="7 days" Foreground="#38BDF8" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="RetentionSlider"
                                    Style="{StaticResource TimelineSliderStyle}"
                                    Minimum="1" Maximum="30" Value="7"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    ValueChanged="RetentionSlider_ValueChanged"
                                    Margin="0,0,0,12"/>

                            <CheckBox x:Name="AutoSkipPrivateCheckBox"
                                      Style="{StaticResource ObsidianCheckBoxStyle}"
                                      Content="Automatically skip Incognito, InPrivate, Private Browsing &amp; Tor windows"/>
                        </StackPanel>
                    </Border>

                    <!-- Privacy Blocklist Editor Card -->
                    <Border Background="#12161E" BorderBrush="#232A36" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Privacy Shield Blocklist" Foreground="#F1F5F9" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="One process name or app keyword per line (case-insensitive). Matching windows are never captured." Foreground="#64748B" FontSize="11.5" Margin="0,0,0,8"/>

                            <TextBox x:Name="BlockedAppsTextBox"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Height="110"
                                     Background="#090B0E"
                                     Foreground="#F1F5F9"
                                     CaretBrush="#38BDF8"
                                     BorderBrush="#232A36"
                                     BorderThickness="1"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Padding="10,8"/>
                        </StackPanel>
                    </Border>

                    <!-- Vault Management & Danger Zone -->
                    <Border Background="#12161E" BorderBrush="#232A36" BorderThickness="1" CornerRadius="10" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="📂 Open Local Vault Folder"
                                    Style="{StaticResource ObsidianButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Click="OpenVaultFolderButton_Click"/>

                            <Button Grid.Column="1"
                                    Content="🔥 Nuke Entire Vault"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="NukeEntireVaultButton_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="#12161E"
                    BorderBrush="#232A36"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14"
                    Padding="20,12">
                <Grid>
                    <TextBlock x:Name="SavedStatusText" Text="" Foreground="#10B981" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource ObsidianButtonStyle}" Margin="0,0,10,0" Click="CloseButton_Click"/>
                        <Button Content="Save Settings" Style="{StaticResource CyanButtonStyle}" Click="SaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
